# Fireup Development Environment Configuration

# PostgreSQL Configuration
#
# POSTGRES_DB and POSTGRES_USER are not free to change: init.sql hardcodes
# `fireup_dev` and the role `fireup`, so renaming either one aborts the
# container's first-run initialization. Measured, with both error messages, in
# DEPLOYMENT.md §1.
#
# POSTGRES_HOST is read by tests/deployment_tests.rs, not by the binary.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fireup_dev
POSTGRES_USER=fireup
POSTGRES_PASSWORD=fireup_dev_password

# Read by nothing in this repository — the CLI takes `--postgres-url`, and a URL
# without a password falls back to PGPASSWORD. Left commented so it does not
# read as configuration (#119).
# DATABASE_URL=postgresql://fireup:fireup_dev_password@localhost:5433/fireup_dev

# Integration tests (required for `cargo test --test integration_tests` Postgres cases).
# Use Docker Compose Postgres on port 5433 — never the host Paperclip role/database.
# FIREUP_TEST_POSTGRES_URL=postgresql://fireup:fireup_dev_password@localhost:5433/fireup_test
# TEST_DATABASE_URL=postgresql://fireup:fireup_dev_password@localhost:5433/fireup_test
# Optional: set FIREUP_TEST_ALLOW_CREATE_DATABASE=1 only when the URL user has CREATEDB.

# Logging Configuration
#
# RUST_LOG reaches the fireup-local container but changes nothing: the
# subscriber is built with with_max_level() from the CLI flags, not with an
# EnvFilter. Use --log-level / --verbose / --json-logs. Measured in
# DEPLOYMENT.md §3.
RUST_LOG=fireup=debug,info
RUST_BACKTRACE=1

# Application Configuration
#
# All three are read by no code. The live equivalents are flags on
# `fireup import`: --batch-size (1000), --max-connections (5), --timeout (300).
# Left commented rather than deleted so they are not re-added as settings.
# FIREUP_MAX_BATCH_SIZE=1000
# FIREUP_CONNECTION_POOL_SIZE=10
# FIREUP_IMPORT_TIMEOUT_SECONDS=3600